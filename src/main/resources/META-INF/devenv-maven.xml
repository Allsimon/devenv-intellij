<!-- Loaded only in IDEs that bundle the Maven plugin; see the optional <depends> in plugin.xml. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.allsimon.intellij.maven.DevenvMavenHomeActivity"/>
    </extensions>

    <applicationListeners>
        <listener class="com.allsimon.intellij.maven.DevenvMavenSettingsListener"
                  topic="com.allsimon.intellij.core.DevenvSettingsListener"/>
    </applicationListeners>
</idea-plugin>
