<!-- Loaded only in IDEs that bundle the Gradle plugin; see the optional <depends> in plugin.xml. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.allsimon.intellij.gradledist.DevenvGradleDistributionActivity"/>
    </extensions>

    <applicationListeners>
        <listener class="com.allsimon.intellij.gradledist.DevenvGradleSettingsListener"
                  topic="com.allsimon.intellij.core.DevenvSettingsListener"/>
    </applicationListeners>
</idea-plugin>
