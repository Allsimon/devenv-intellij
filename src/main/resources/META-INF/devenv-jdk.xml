<!-- Loaded only in IDEs that bundle the Java plugin; see the optional <depends> in plugin.xml. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.allsimon.intellij.jdk.DevenvProjectSdkActivity"/>
    </extensions>

    <applicationListeners>
        <listener class="com.allsimon.intellij.jdk.DevenvJdkSettingsListener"
                  topic="com.allsimon.intellij.core.DevenvSettingsListener"/>
    </applicationListeners>
</idea-plugin>
