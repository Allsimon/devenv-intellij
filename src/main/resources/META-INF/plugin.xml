<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.allsimon.devenv</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Devenv</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/Allsimon/devenv-intellij">Sources</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Adds support for <a href="https://devenv.sh">devenv</a> in IntelliJ-based IDEs.<br>
        Brings support for most devenv features, including <code>devenv.nix</code> editing, environment management, and integration with the devenv CLI.<br><br>
        This is an unofficial, community-maintained plugin and is not affiliated with the devenv project.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <!-- The Services tool window and its serviceViewContributor extension point live in modules.lang. -->
    <depends>com.intellij.modules.lang</depends>
    <!-- Optional: the Project SDK support needs the Java plugin, which only some IDEs bundle. Every
         other feature of this plugin stays available in the ones that don't. -->
    <depends optional="true" config-file="devenv-jdk.xml">com.intellij.modules.java</depends>
    <!-- Optional likewise: the Gradle distribution support needs the Gradle plugin. -->
    <depends optional="true" config-file="devenv-gradle.xml">com.intellij.gradle</depends>
    <!-- And the Maven home support, the Maven plugin. -->
    <depends optional="true" config-file="devenv-maven.xml">org.jetbrains.idea.maven</depends>
    <!-- And the Node.js interpreter support, the JavaScript plugin. -->
    <depends optional="true" config-file="devenv-javascript.xml">JavaScript</depends>
    <!-- And the devenv.yaml schema, the JSON plugin, which owns the schema machinery. The YAML plugin
         is what applies a mapped schema to a .yaml file; where it is missing, devenv.yaml simply keeps
         no schema. -->
    <depends optional="true" config-file="devenv-schema.xml">com.intellij.modules.json</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <serviceViewContributor
                implementation="com.allsimon.intellij.processes.DevenvServiceViewContributor"/>

        <writingAccessProvider implementation="com.allsimon.intellij.core.NixStoreWritingAccessProvider"/>

        <directoryIndexExcludePolicy
                implementation="com.allsimon.intellij.core.DevenvExcludePolicy"/>

        <formattingService id="devenvTreefmt"
                implementation="com.allsimon.intellij.treefmt.DevenvTreefmtFormattingService"/>
        <formattingService id="devenvNixfmt" order="after devenvTreefmt"
                implementation="com.allsimon.intellij.nixfmt.AffogatoFormattingService"/>

        <localInspection shortName="AffogatoLint" language="" bundle="messages.MyMessageBundle"
                         key="inspection.nixlint.name" groupKey="inspection.nixlint.group"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="com.allsimon.intellij.nixlint.AffogatoLintInspection"/>

        <fileType name="AffogatoNix" language="AffogatoNix" extensions="nix" fieldName="INSTANCE"
                  implementationClass="com.allsimon.intellij.nixlang.NixFileType"/>
        <lang.parserDefinition language="AffogatoNix"
                               implementationClass="com.allsimon.intellij.nixlang.NixParserDefinition"/>
        <lang.syntaxHighlighterFactory language="AffogatoNix"
                                       implementationClass="com.allsimon.intellij.nixlang.NixHighlighterFactory"/>
        <annotator language="AffogatoNix" implementationClass="com.allsimon.intellij.nixlang.NixAnnotator"/>
        <lang.braceMatcher language="AffogatoNix" implementationClass="com.allsimon.intellij.nixlang.NixBraceMatcher"/>
        <lang.quoteHandler language="AffogatoNix" implementationClass="com.allsimon.intellij.nixlang.NixQuoteHandler"/>
        <colorSettingsPage implementation="com.allsimon.intellij.nixlang.NixColorSettingsPage"/>
        <liveTemplateContext contextId="NIX" implementation="com.allsimon.intellij.nixlang.NixTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Nix.xml"/>
        <codeInsight.template.postfixTemplateProvider language="AffogatoNix"
                implementationClass="com.allsimon.intellij.nixlang.NixPostfixTemplateProvider"/>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixToggleQuotesIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixAttributeQuotesIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixExpandBindingIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixCollapseBindingIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixInlineBindingIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixExtractBindingIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixWrapInMkIfIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixUnwrapMkIfIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixAddFormalIntention</className>
            <category>Nix</category>
        </intentionAction>
        <intentionAction>
            <language>AffogatoNix</language>
            <className>com.allsimon.intellij.nixlang.NixPrefetchIntention</className>
            <category>Nix</category>
        </intentionAction>
        <spellchecker.support language="AffogatoNix"
                              implementationClass="com.allsimon.intellij.nixlang.NixSpellcheckingStrategy"/>
        <indexPatternBuilder implementation="com.allsimon.intellij.nixlang.NixIndexPatternBuilder"/>
        <todoIndexer filetype="AffogatoNix" implementationClass="com.allsimon.intellij.nixlang.NixTodoIndexer"/>
        <lang.elementManipulator forClass="com.allsimon.intellij.nixlang.NixStringElement"
                                 implementationClass="com.allsimon.intellij.nixlang.NixStringManipulator"/>
        <lang.elementManipulator forClass="com.allsimon.intellij.nixlang.NixPathElement"
                                 implementationClass="com.allsimon.intellij.nixlang.NixPathManipulator"/>
        <multiHostInjector implementation="com.allsimon.intellij.nixlang.NixInjector"/>
        <applicationConfigurable parentId="language" id="com.allsimon.intellij.nixlang"
                                 instance="com.allsimon.intellij.nixlang.NixInjectionConfigurable" displayName="Nix"/>
        <lang.commenter language="AffogatoNix" implementationClass="com.allsimon.intellij.nixlang.NixCommenter"/>
        <lang.foldingBuilder language="AffogatoNix" implementationClass="com.allsimon.intellij.nixlang.NixFoldingBuilder"/>
        <lang.psiStructureViewFactory language="AffogatoNix"
                                      implementationClass="com.allsimon.intellij.nixlang.NixStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="com.allsimon.intellij.nixlang.NixBreadcrumbsProvider"/>
        <codeInsight.parameterInfo language="AffogatoNix"
                                   implementationClass="com.allsimon.intellij.nixlang.NixParameterInfoHandler"/>
        <completion.contributor language="AffogatoNix"
                                implementationClass="com.allsimon.intellij.nixlang.NixCompletionContributor"/>
        <platform.backend.documentation.targetProvider
                implementation="com.allsimon.intellij.nixlang.NixDocumentationTargetProvider"/>
        <platform.backend.documentation.lookupElementTargetProvider
                implementation="com.allsimon.intellij.nixlang.NixDocumentationTargetProvider"/>
        <gotoDeclarationHandler implementation="com.allsimon.intellij.nixlang.NixGotoDeclarationHandler"/>
        <codeInsight.declarativeInlayProvider language="AffogatoNix" providerId="nix.versions"
                                              implementationClass="com.allsimon.intellij.nixlang.NixVersionInlayProvider"
                                              isEnabledByDefault="true" group="VALUES_GROUP"
                                              bundle="messages.MyMessageBundle" nameKey="inlay.nix.versions.name"
                                              descriptionKey="inlay.nix.versions.description"/>
        <lang.findUsagesProvider language="AffogatoNix"
                                 implementationClass="com.allsimon.intellij.nixlang.NixFindUsagesProvider"/>

        <syntaxHighlighter key="PLAIN_TEXT"
                           factoryClass="com.allsimon.intellij.nixhighlight.NixSyntaxHighlighterProvider"/>
        <syntaxHighlighter key="AUTO_DETECTED"
                           factoryClass="com.allsimon.intellij.nixhighlight.NixSyntaxHighlighterProvider"/>

        <configurationType implementation="com.allsimon.intellij.run.NixRunConfigurationType"/>
        <consoleFilterProvider implementation="com.allsimon.intellij.run.NixLocationFilter$Provider"/>
        <consoleFilterProvider implementation="com.allsimon.intellij.run.NixHashMismatchFilter$Provider"/>
        <runLineMarkerContributor language="AffogatoNix"
                                  implementationClass="com.allsimon.intellij.run.NixRunLineMarkerContributor"/>

        <notificationGroup id="Devenv" displayType="BALLOON"
                           bundle="messages.MyMessageBundle" key="notification.devenv.group"/>
    </extensions>

    <applicationListeners>
        <listener class="com.allsimon.intellij.nixeval.NixSavedListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <actions>
        <action id="Nix.Evaluate" class="com.allsimon.intellij.nixlang.NixEvalAction"
                text="Evaluate with nix eval" description="Shows the value nix eval gives for the selection">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="org.intellij.intelliLang">
        <languageSupport implementation="com.allsimon.intellij.nixlang.NixInjectionSupport"/>
    </extensions>

</idea-plugin>
