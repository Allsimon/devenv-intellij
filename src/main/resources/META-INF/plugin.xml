<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.allsimon.devenv</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Devenv</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/Allsimon/devenv-intellij">Sources</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Adds support for <a href="https://devenv.sh">devenv</a> in IntelliJ-based IDEs.<br>
        Brings support for most devenv features, including <code>devenv.nix</code> editing, environment management, and integration with the devenv CLI.<br><br>
        This is an unofficial, community-maintained plugin and is not affiliated with the devenv project.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.lsp</depends>
    <!-- The Services tool window and its serviceViewContributor extension point live in modules.lang. -->
    <depends>com.intellij.modules.lang</depends>
    <!-- Optional: the Project SDK support needs the Java plugin, which only some IDEs bundle. Every
         other feature of this plugin stays available in the ones that don't. -->
    <depends optional="true" config-file="devenv-jdk.xml">com.intellij.modules.java</depends>
    <!-- Optional likewise: the Gradle distribution support needs the Gradle plugin. -->
    <depends optional="true" config-file="devenv-gradle.xml">com.intellij.gradle</depends>
    <!-- And the Maven home support, the Maven plugin. -->
    <depends optional="true" config-file="devenv-maven.xml">org.jetbrains.idea.maven</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MyToolWindow" factoryClass="com.allsimon.intellij.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>

        <platform.lsp.serverSupportProvider
                implementation="com.allsimon.intellij.lsp.DevenvLspServerSupportProvider"/>

        <serviceViewContributor
                implementation="com.allsimon.intellij.processes.DevenvServiceViewContributor"/>

        <directoryIndexExcludePolicy
                implementation="com.allsimon.intellij.core.DevenvExcludePolicy"/>

        <formattingService
                implementation="com.allsimon.intellij.treefmt.DevenvTreefmtFormattingService"/>

        <notificationGroup id="Devenv" displayType="BALLOON"
                           bundle="messages.MyMessageBundle" key="notification.devenv.group"/>
    </extensions>

</idea-plugin>
